<Window x:Class="PersonalAiWorkspace.Desktop.MemoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Memory" Width="1040" Height="760" MinWidth="820" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="#F4F6F8">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="8"/><Setter Property="FontSize" Value="15"/>
      <Setter Property="BorderBrush" Value="#CAD2DD"/><Setter Property="IsUndoEnabled" Value="False"/>
    </Style>
  </Window.Resources>
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Memory" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="Local Only · User Controlled · 显式保存" Foreground="#475569" Margin="0,4,0,12"/>
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,0,0,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox" KeyDown="SearchKeyDown" Margin="0,0,10,0" AutomationProperties.Name="Search Memory"/>
      <Button Grid.Column="1" x:Name="SearchButton" Content="Search" Click="Search"/>
      <Button Grid.Column="2" x:Name="RefreshButton" Content="Refresh" Click="Refresh"/>
    </Grid>
    <WrapPanel Grid.Row="2" Margin="0,0,0,12">
      <TextBlock Text="Status" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <ComboBox x:Name="StatusFilter" Width="100" SelectedIndex="0" SelectionChanged="FilterChanged" Margin="0,0,12,0">
        <ComboBoxItem Content="Active"/><ComboBoxItem Content="Archived"/>
      </ComboBox>
      <TextBlock Text="Type" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <ComboBox x:Name="TypeFilter" Width="140" SelectedIndex="0" SelectionChanged="FilterChanged" Margin="0,0,20,0">
        <ComboBoxItem Content="All"/><ComboBoxItem Content="Preference"/><ComboBoxItem Content="Project Note"/>
      </ComboBox>
      <Button x:Name="PreviousButton" Content="Previous" Click="Previous"/>
      <TextBlock x:Name="PageText" Text="Page 1" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <Button x:Name="NextButton" Content="Next" Click="Next"/>
    </WrapPanel>
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <DataGrid x:Name="MemoryList" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                CanUserDeleteRows="False" CanUserSortColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
                SelectionChanged="ItemSelected" HeadersVisibility="Column" AutomationProperties.Name="Memory list">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
          <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100"/>
          <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="75"/>
          <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="125"/>
          <DataGridTextColumn Header="Rev" Binding="{Binding Revision}" Width="45"/>
        </DataGrid.Columns>
      </DataGrid>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Type" FontWeight="SemiBold"/>
        <ComboBox Grid.Row="1" x:Name="EditorType" SelectedIndex="1" SelectionChanged="EditorTypeChanged" Margin="0,4,0,10">
          <ComboBoxItem Content="Preference"/><ComboBoxItem Content="Project Note"/>
        </ComboBox>
        <TextBlock Grid.Row="2" Text="Title · ≤ 160 Unicode 字符" FontWeight="SemiBold"/>
        <TextBox Grid.Row="3" x:Name="TitleBox" TextChanged="EditorTextChanged" Margin="0,4,0,10" AutomationProperties.Name="Memory title"/>
        <TextBlock Grid.Row="4" Text="Content · ≤ 2000 UTF-16 单位 · ≤ 8192 UTF-8 字节" FontWeight="SemiBold"/>
        <TextBox Grid.Row="5" x:Name="ContentBox" TextChanged="EditorTextChanged" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Margin="0,4,0,10" AutomationProperties.Name="Memory content"/>
        <TextBlock Grid.Row="6" x:Name="MetadataText" Text="New · 尚未保存" TextWrapping="Wrap" Foreground="#475569" Margin="0,0,0,10"/>
        <WrapPanel Grid.Row="7">
          <Button x:Name="NewButton" Content="New" Click="New"/>
          <Button x:Name="SaveButton" Content="Save" Click="Save"/>
          <Button x:Name="LifecycleButton" Content="Archive" Click="Lifecycle"/>
          <Button x:Name="DeleteButton" Content="Delete" Click="Delete"/>
          <Button x:Name="ReloadButton" Content="Reload" Click="Reload"/>
        </WrapPanel>
      </Grid>
    </Grid>
    <DockPanel Grid.Row="4" Margin="0,14,0,0">
      <Button DockPanel.Dock="Right" Content="Close" Click="CloseMemory" Margin="12,0,0,0"/>
      <TextBlock x:Name="StatusText" Text="Ready · 管理内容不会加入 Ask" TextWrapping="Wrap" VerticalAlignment="Center"/>
    </DockPanel>
  </Grid>
</Window>
