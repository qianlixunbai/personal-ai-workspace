* text=auto eol=lf
/mvnw text eol=lf
*.cmd text eol=crlf
*.java text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.properties text eol=lf
# Preserve the frozen Finance migration bytes and recorded SHA-256 across checkouts.
/finance-domain/src/main/resources/db/finance/migration/*.sql -text
# Preserve one-time frozen asset source copies and their provenance hashes.
/finance-domain/src/main/java/com/financeos/module/asset/**/*.java -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Preserve frozen investment reads, DTOs and cursor dependencies byte for byte.
/finance-domain/src/main/java/com/financeos/module/investment/**/*.java -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/finance-domain/src/main/java/com/financeos/module/importing/dto/*.java -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/finance-domain/src/main/java/com/financeos/common/BusinessException.java -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
