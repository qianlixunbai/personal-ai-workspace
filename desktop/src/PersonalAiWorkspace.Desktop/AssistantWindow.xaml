<Window x:Class="PersonalAiWorkspace.Desktop.AssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personal AI Assistant · Translate" Width="700" Height="760" MinWidth="500" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="#F4F6F8">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="10"/><Setter Property="FontSize" Value="15"/>
      <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="BorderBrush" Value="#CAD2DD"/>
    </Style>
  </Window.Resources>
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
      <TextBlock Text="Translate" FontSize="26" FontWeight="SemiBold"/>
      <TextBlock Text="Local Only · Ctrl+Alt+Shift+T · 仅主动触发读取选区" Foreground="#475569" Margin="0,4,0,12"/>
      <TextBlock x:Name="HealthText" Text="正在检查 Runtime…" TextWrapping="Wrap" Foreground="#475569"/>
      <TextBlock x:Name="CredentialText" TextWrapping="Wrap" Margin="0,4,0,8"/>
      <TextBlock x:Name="HotkeyText" TextWrapping="Wrap" Foreground="#9A3412"/>
    </StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,8,0,10">
      <Button x:Name="ImportButton" Content="导入 Runtime 凭据…" Click="ImportCredential"/>
      <Button x:Name="ForgetButton" Content="忘记凭据" Click="ForgetCredential"/>
      <Button Content="检查 Runtime" Click="CheckRuntime"/>
    </WrapPanel>
    <StackPanel Grid.Row="2" Margin="0,0,0,8">
      <CheckBox x:Name="CopyFallback" IsChecked="True" Content="UIA 不支持时，允许一次受控 Copy"/>
      <TextBlock Text="备用复制仅支持已验证原生编辑控件及空/纯文本剪贴板；其他控件请手动输入。无正文日志或历史记录。"
                 Foreground="#475569" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,6"/>
      <TextBlock Text="Input · 可手动输入或粘贴" FontWeight="SemiBold"/>
    </StackPanel>
    <TextBox Grid.Row="3" x:Name="InputText" AcceptsReturn="True" MaxLength="4000"/>
    <WrapPanel Grid.Row="4" Margin="0,12,0,8">
      <TextBlock Text="目标语言" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <ComboBox x:Name="TargetLanguage" SelectedIndex="0" Width="100" Margin="0,0,12,0" VerticalContentAlignment="Center">
        <ComboBoxItem Content="zh-CN"/><ComboBoxItem Content="en"/><ComboBoxItem Content="ja"/>
      </ComboBox>
      <Button x:Name="TranslateButton" Content="Translate" Click="Translate"/>
      <Button x:Name="CancelButton" Content="Cancel" Click="Cancel" IsEnabled="False"/>
    </WrapPanel>
    <StackPanel Grid.Row="5" Margin="0,0,0,8">
      <TextBlock x:Name="StatusText" Text="Ready · 关闭窗口后继续在托盘运行" TextWrapping="Wrap"/>
      <TextBlock Text="Result · 纯文本" FontWeight="SemiBold" Margin="0,8,0,0"/>
    </StackPanel>
    <TextBox Grid.Row="6" x:Name="ResultText" IsReadOnly="True" AcceptsReturn="True"/>
    <WrapPanel Grid.Row="7" Margin="0,12,0,0">
      <Button x:Name="CopyButton" Content="Copy result" Click="CopyResult" IsEnabled="False"/>
      <Button Content="关闭到托盘" Click="CloseToTray"/>
      <TextBlock Text="退出应用请使用托盘菜单" VerticalAlignment="Center" Foreground="#475569"/>
    </WrapPanel>
  </Grid>
</Window>
