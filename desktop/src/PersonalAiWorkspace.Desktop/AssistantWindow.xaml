<Window x:Class="PersonalAiWorkspace.Desktop.AssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快速助手 · Personal AI Workspace" Width="540" SizeToContent="Height" MaxHeight="760" MinWidth="460" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="#F3F3F3" Foreground="#202020" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="MinHeight" Value="34"/><Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#D6D6D6"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#005FB8"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="12"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#D6D6D6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#005FB8"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="MinHeight" Value="34"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="20,16">
    <DockPanel Margin="0,0,0,16">
      <ComboBox x:Name="ActionSelector" DockPanel.Dock="Right" SelectedIndex="0" SelectionChanged="ActionChanged" Width="150" HorizontalAlignment="Right" AutomationProperties.Name="选择操作">
        <ComboBoxItem Content="翻译"/><ComboBoxItem Content="总结"/><ComboBoxItem Content="解释 / 提问"/>
      </ComboBox>
      <TextBlock Text="快速助手" FontSize="20" FontWeight="SemiBold"/>
    </DockPanel>
    <TextBlock x:Name="HotkeyText" TextWrapping="Wrap" Foreground="#9A3412"/>
    <TextBlock x:Name="InputLabel" Text="输入文字" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <TextBox x:Name="InputText" AcceptsReturn="True" MaxLength="6000" Height="112" AutomationProperties.Name="原文"/>
    <StackPanel x:Name="MemoryAskPanel" Visibility="Collapsed" Margin="0,10,0,0">
      <WrapPanel>
        <Button x:Name="UseMemoryButton" Content="选择记忆…" Click="UseMemory"/>
        <Button x:Name="ClearMemoryButton" Content="清除记忆" Click="ClearMemory" IsEnabled="False"/>
        <TextBlock x:Name="MemoryCountText" Text="未选择记忆" VerticalAlignment="Center"/>
      </WrapPanel>
      <TextBlock x:Name="MemorySelectionText" TextWrapping="Wrap" Margin="0,4,0,0"/>
    </StackPanel>
    <StackPanel x:Name="QuestionPanel" Visibility="Collapsed" Margin="0,10,0,0">
      <TextBlock x:Name="QuestionLabel" Text="想了解什么？留空则解释原文" TextWrapping="Wrap"/>
      <TextBox x:Name="QuestionText" MaxLength="1000" Margin="0,6,0,0" AutomationProperties.Name="附加问题"/>
    </StackPanel>
    <WrapPanel Margin="0,12,0,12">
      <TextBlock x:Name="LanguageLabel" Text="译为" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <ComboBox x:Name="TargetLanguage" SelectedIndex="0" Width="100" Margin="0,0,12,0" AutomationProperties.Name="目标语言">
        <ComboBoxItem Content="简体中文" Tag="zh-CN"/><ComboBoxItem Content="英语" Tag="en"/><ComboBoxItem Content="日语" Tag="ja"/>
      </ComboBox>
      <Button x:Name="TranslateButton" Content="翻译" Click="Translate" Background="#005FB8" Foreground="White" BorderBrush="#005FB8"/>
      <Button x:Name="CancelButton" Content="取消" Click="Cancel" IsEnabled="False"/>
    </WrapPanel>
    <TextBlock x:Name="StatusText" Text="输入文字后开始" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
    <DockPanel Margin="0,0,0,8">
      <Button x:Name="CopyButton" DockPanel.Dock="Right" Content="复制结果" Click="CopyResult" IsEnabled="False" Margin="0" Padding="10,5"/>
      <TextBlock Text="结果" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </DockPanel>
    <TextBox x:Name="ResultText" IsReadOnly="True" AcceptsReturn="True" Height="112" AutomationProperties.Name="处理结果"/>
    <TextBlock Text="Esc 关闭并清除本次内容" Foreground="#606060" FontSize="12" Margin="0,10,0,0"/>
    <Expander x:Name="MaintenancePanel" Header="取词选项与连接维护" Margin="0,10,0,0">
      <StackPanel Margin="0,10,0,0">
        <CheckBox x:Name="CopyFallback" IsChecked="True" Content="允许备用复制取词"/>
        <TextBlock Text="无法直接读取选区时，尝试一次受控复制。仅支持已验证的原生编辑控件和空或纯文本剪贴板，完成后尝试恢复剪贴板；其他情况请手动粘贴。" Foreground="#606060" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,12"/>
        <TextBlock x:Name="HealthText" Text="尚未检查本机服务" TextWrapping="Wrap" Foreground="#606060"/>
        <TextBlock x:Name="CredentialText" TextWrapping="Wrap" Margin="0,4,0,8"/>
        <WrapPanel Margin="0,8,0,10">
          <Button x:Name="ImportButton" Content="导入连接凭据…" Click="ImportCredential"/>
          <Button x:Name="ForgetButton" Content="忘记凭据" Click="ForgetCredential"/>
          <Button Content="检查连接" Click="CheckRuntime"/>
          <Button x:Name="PairBrowserButton" Content="浏览器配对…" Click="PairBrowser"/>
          <Button x:Name="MemoryButton" Content="记忆…" Click="OpenMemory"/>
          <Button x:Name="ConversationButton" Content="对话…" Click="OpenConversation"/>
          <Button x:Name="WorkspaceBackupButton" Content="工作区备份…" Click="OpenWorkspaceBackup"/>
        </WrapPanel>
        <Button Content="关闭到托盘" Click="CloseToTray" HorizontalAlignment="Left"/>
        <TextBlock Text="退出应用请使用托盘菜单" Foreground="#606060" FontSize="12" Margin="0,8,0,0"/>
      </StackPanel>
    </Expander>
  </StackPanel>
  </ScrollViewer>
</Window>
