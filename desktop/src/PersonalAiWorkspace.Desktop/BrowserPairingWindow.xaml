<Window x:Class="PersonalAiWorkspace.Desktop.BrowserPairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pair Browser" Width="650" Height="720" MinWidth="560" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="#F4F6F8">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="10"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="BorderBrush" Value="#CAD2DD"/><Setter Property="IsUndoEnabled" Value="False"/>
    </Style>
  </Window.Resources>
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
      <TextBlock Text="Browser Extension Origin" FontWeight="SemiBold"/>
      <TextBox x:Name="OriginText" MaxLength="128" Margin="0,8"/>
      <TextBlock Text="chrome-extension:// 加 32 个 a-p 小写字符，无尾斜线。请核对扩展身份；点击下方按钮即明确批准此 Origin。"
                 TextWrapping="Wrap" Foreground="#475569" Margin="0,0,0,10"/>
      <Button x:Name="CreatePairingButton" Content="创建一次性配对" Click="CreatePairing" HorizontalAlignment="Left"/>
    </StackPanel>
    <TextBlock Grid.Row="1" x:Name="PairingStatusText" Text="仅创建配对；请在扩展中完成 exchange。" TextWrapping="Wrap" Margin="0,10"/>
    <StackPanel Grid.Row="2" x:Name="PairingDetails" Visibility="Collapsed">
      <TextBlock Text="Pairing ID"/><TextBox x:Name="PairingIdText" IsReadOnly="True" Margin="0,4,0,8"/>
      <TextBlock Text="One-time pairing secret"/><TextBox x:Name="PairingSecretText" IsReadOnly="True" Margin="0,4,0,8"/>
      <TextBlock Text="Expires at（本机时区）"/><TextBox x:Name="ExpiresAtText" IsReadOnly="True" Margin="0,4,0,8"/>
      <WrapPanel>
        <Button x:Name="CopyPairingIdButton" Content="Copy Pairing ID" Click="CopyPairingId" IsEnabled="False"/>
        <Button x:Name="CopySecretButton" Content="Copy Secret" Click="CopySecret" IsEnabled="False"/>
      </WrapPanel>
      <TextBlock Text="Secret 仅在本窗口内存中临时显示。显式复制会写入系统剪贴板，其历史/同步由 Windows 设置控制。关闭窗口不会撤销 Runtime 中的 session，它将在 3 分钟后过期。"
                 TextWrapping="Wrap" Foreground="#475569" FontSize="12" Margin="0,8,0,12"/>
    </StackPanel>
    <WrapPanel Grid.Row="3" Margin="0,8">
      <TextBlock Text="Paired Browsers" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <Button x:Name="RefreshClientsButton" Content="刷新列表" Click="RefreshClients"/>
      <Button x:Name="RevokeClientButton" Content="Revoke selected" Click="RevokeClient" IsEnabled="False"/>
    </WrapPanel>
    <ListBox Grid.Row="4" x:Name="ClientsList" SelectionChanged="ClientSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="4,6">
            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Origin}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding CreatedAt, StringFormat=Created at: {0:yyyy-MM-dd HH:mm:ss zzz}}"/>
            <TextBlock Text="{Binding CapabilitiesText, StringFormat=Allowed capabilities: {0}}"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Button Grid.Row="5" x:Name="ClosePairingButton" Content="关闭并清除配对显示" Click="ClosePairing" HorizontalAlignment="Left" Margin="0,12,0,0"/>
  </Grid>
</Window>
