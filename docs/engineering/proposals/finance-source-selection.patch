+function Read-RebuiltFinance($Rule) {
+    $jar='inputs/contracts/finance-domain-0.1.0.jar';$proof='inputs/contracts/finance-build-receipt.json'
+    if(-not $script:InputHashes.ContainsKey($jar) -or -not $script:InputHashes.ContainsKey($proof) -or
+        $script:InputHashes[$jar] -cne $Rule.sha256 -or $script:InputHashes[$proof] -cne $script:Spec.financeBuild.receiptSha256){throw 'Reviewed rebuilt finance inputs required'}
+    $receiptPath=Resolve-Below $Root $proof
+    if((Get-Sha $receiptPath) -cne $script:Spec.financeBuild.receiptSha256){throw 'Finance receipt changed'}
+    $receipt=Read-StrictJson $receiptPath
+    if($receipt.format -cne 'WORKSPACE_FINANCE_BUILD_RECEIPT_V1' -or $receipt.productRevision -cne $script:ProductRevision -or
+        $receipt.exitCode -ne 0 -or $receipt.jobCleanupConfirmed -isnot [bool] -or $receipt.oldFinanceClassesUsed -isnot [bool] -or
+        $receipt.jobCleanupConfirmed -ne $true -or $receipt.oldFinanceClassesUsed -ne $false -or
+        $receipt.output.sha256 -cne $Rule.sha256 -or $receipt.output.bytes -ne $Rule.bytes){throw 'Finance provenance is incomplete'}
+    if($receipt.javacSha256 -cne '6fe0b34e9b47d255351040c9ad5920cad9c37d5a10a60916cd2c84299d0c40af' -or
+        $receipt.jdkInventorySha256 -cne 'c9acc39c25271fae0b3af7b4af7911e9fcd12e505505273d5c1efa73ed36a95f' -or
+        $receipt.lombokSha256 -cne '01f7b1a015e33e2b62d5f5f37053306357ab1415fd181fcba7794f5d198c1126' -or
+        ($receipt.processors -join ',') -cne 'lombok.launch.AnnotationProcessorHider$AnnotationProcessor,lombok.launch.AnnotationProcessorHider$ClaimingProcessor'){throw 'Unreviewed finance compiler/processor'}
+    $inputs=@($script:SourceFiles | Where-Object { $_.path -clike 'finance-domain/src/main/java/*.java' -or $_.path -clike 'finance-domain/src/main/resources/*' })
+    if($inputs.Count -ne 75){throw 'Finance source/resource scope changed'}
+    $sourceNames=[Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)
+    foreach($item in $receipt.sourceInputs){Assert-RelativePath $item.path;if(-not $sourceNames.Add($item.path)){throw 'Duplicate finance source receipt path'}}
+    Assert-SameInventory $inputs $receipt.sourceInputs
+    $dependencies=@($script:Spec.jarEntries | Where-Object role -CEQ 'dependency')
+    if($dependencies.Count -ne 77 -or ($dependencies.path -join '|') -cne ($receipt.classpath.path -join '|')){throw 'Finance classpath order differs'}
+    Assert-SameInventory $dependencies $receipt.classpath
+    $path=Resolve-Below $Root $jar
+    if((Get-Item -LiteralPath $path).Length -ne $Rule.bytes -or (Get-Sha $path) -cne $Rule.sha256){throw 'Finance output changed'}
+    $script:FinanceProvenance=@{kind='rebuilt-fixed-source';productRevision=$script:ProductRevision;receiptSha256=$script:Spec.financeBuild.receiptSha256;source=$jar;sha256=$Rule.sha256;oldFinanceClassesUsed=$false}
+    Write-NewJson (Resolve-Below $Root 'evidence/finance-source.json') $script:FinanceProvenance
+    return ,([IO.File]::ReadAllBytes($path))
+}
