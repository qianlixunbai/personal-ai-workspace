<Window x:Class="PersonalAiWorkspace.Desktop.MainWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Personal AI Workspace" Width="1440" Height="900" MinWidth="780" MinHeight="540"
        WindowStartupLocation="CenterScreen" Background="#F3F3F3" FontFamily="Segoe UI, Microsoft YaHei UI">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="0,0,0,1" Padding="12,5">
            <Border.Resources>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.8" /></Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.6" /></Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" /><Setter TargetName="ButtonSurface" Property="BorderThickness" Value="2" /></Trigger>
                                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.5" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Border.Resources>
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="−" Click="ZoomOut" Padding="10,5" Margin="2,0" AutomationProperties.Name="缩小工作区" />
                    <Button x:Name="ZoomResetButton" Content="100%" Click="ResetZoom" Padding="10,5" Margin="2,0" AutomationProperties.Name="恢复工作区缩放" />
                    <Button x:Name="ZoomInButton" Content="+" Click="ZoomIn" Padding="10,5" Margin="2,0" AutomationProperties.Name="放大工作区" />
                    <Button x:Name="NativeAssistantButton" Content="快速助手" Click="OpenAssistant" Padding="12,5" Margin="4,0" AutomationProperties.Name="打开快速助手" ToolTip="在原生浮窗中翻译、总结或提问" />
                    <Button Content="聚焦工作区" Click="FocusWorkspace" Padding="12,5" Margin="4,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="开发预览版" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" VerticalAlignment="Center" FontSize="12" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid>
            <wv:WebView2 x:Name="Browser" AutomationProperties.Name="Main Workspace 页面" />
            <Border x:Name="Fallback" Background="#F6F7F9" Padding="40">
                <StackPanel VerticalAlignment="Center" MaxWidth="520">
                    <TextBlock x:Name="FallbackTitle" Text="正在打开工作区…" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock x:Name="FallbackMessage" Text="可先打开快速助手，或从托盘使用其他入口。" TextWrapping="Wrap" Margin="0,16,0,24" />
                    <Button Content="打开快速助手" Click="OpenAssistant" HorizontalAlignment="Left" Padding="16,9" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
