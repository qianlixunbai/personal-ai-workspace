<Window x:Class="PersonalAiWorkspace.Desktop.MainWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Personal AI Workspace" Width="1440" Height="900" MinWidth="780" MinHeight="540"
        WindowStartupLocation="CenterScreen" Background="#0A1C35">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#0A1C35" BorderBrush="#25436A" BorderThickness="0,0,0,1" Padding="16,7">
            <Border.Resources>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#142C4B" />
                    <Setter Property="Foreground" Value="#DCEAFF" />
                    <Setter Property="BorderBrush" Value="#345274" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#224776" /></Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#2868CB" /></Trigger>
                                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.5" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Border.Resources>
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="−" Click="ZoomOut" Padding="10,5" Margin="2,0" AutomationProperties.Name="缩小工作区" />
                    <Button x:Name="ZoomResetButton" Content="100%" Click="ResetZoom" Padding="10,5" Margin="2,0" AutomationProperties.Name="恢复工作区缩放" />
                    <Button x:Name="ZoomInButton" Content="+" Click="ZoomIn" Padding="10,5" Margin="2,0" AutomationProperties.Name="放大工作区" />
                    <Button x:Name="NativeAssistantButton" Content="Quick Assistant" Click="OpenAssistant" Visibility="Collapsed" Padding="12,5" Margin="4,0" AutomationProperties.Name="打开 Quick Assistant fallback" />
                    <Button Content="聚焦工作区" Click="FocusWorkspace" Padding="12,5" Margin="4,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="◇" Foreground="#66AAFF" FontSize="20" Margin="0,0,9,0" />
                    <TextBlock Text="Personal AI Workspace" Foreground="#E5EFFF" VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid>
            <wv:WebView2 x:Name="Browser" AutomationProperties.Name="Main Workspace 页面" />
            <Border x:Name="Fallback" Background="#F6F7F9" Padding="40">
                <StackPanel VerticalAlignment="Center" MaxWidth="520">
                    <TextBlock x:Name="FallbackTitle" Text="正在打开工作区…" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock x:Name="FallbackMessage" Text="等待期间可打开 Quick Assistant；托盘也提供此原生快捷入口。" TextWrapping="Wrap" Margin="0,16,0,24" />
                    <Button Content="打开 Quick Assistant fallback" Click="OpenAssistant" HorizontalAlignment="Left" Padding="16,9" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
